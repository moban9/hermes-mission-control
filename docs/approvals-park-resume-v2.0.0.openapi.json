    "securitySchemes": {
      "pluginAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Originating runtime scoped profile/board identity; not shared UI/ingest authority"
      },
      "ownerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Owner-only decision authority; viewer rejected"
      },
      "bridgeAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Internal event bridge only; never UI/guest"
      }
    }
  }
