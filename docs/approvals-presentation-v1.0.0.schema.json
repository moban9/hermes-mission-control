{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onendo:approval-presentation:1.0.0",
  "title": "Normalized approval presentation",
  "type": "object",
  "required": [
    "summary",
    "what_it_does",
    "affects",
    "reversible",
    "detail",
    "classification",
    "needs_care",
    "contract_version"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!\\s*$)(?!.*[\\r\\n\\x00-\\x1f`|])(?!.*(?:&&|<<|\\$\\(|\\$\\{)).+$"
    },
    "what_it_does": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "affects": {
      "type": "string",
      "pattern": "^(repo|money|none|service:[^\\r\\n]+|files:[^\\r\\n]+)$"
    },
    "reversible": {
      "type": "boolean"
    },
    "detail": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "read",
        "read-only-test",
        "repo-write",
        "file-write",
        "delete",
        "process-control",
        "service-control",
        "permissions",
        "network-write",
        "dns-change",
        "spend",
        "unknown"
      ]
    },
    "needs_care": {
      "type": "boolean"
    },
    "contract_version": {
      "const": "1.0.0"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "unknown"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "summary": {
            "const": "Unclassified action — inspect the detail"
          },
          "needs_care": {
            "const": true
          },
          "reversible": {
            "const": false
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
