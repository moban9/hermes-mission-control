{
  "openapi": "3.1.0",
  "info": {
    "title": "MC Approval UX additive API",
    "version": "1.0.0",
    "description": "Additive contract. Existing event envelopes, authentication and decision routes unchanged. Normalized presentation follows companion JSON Schema."
  },
  "paths": {
    "/v1/approvals/{identifier}/seen": {
      "post": {
        "operationId": "markApprovalSeen",
        "summary": "Record the first visible owner display, not consent",
        "security": [
          {
            "OwnerBearer": []
          }
        ],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Idempotent canonical approval with server first_seen_at",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Approval"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid identity"
          },
          "403": {
            "description": "Guest, anonymous or ingest identity; no mutation"
          },
          "404": {
            "description": "Approval absent"
          }
        }
      }
    },
    "/v1/approvals": {
      "get": {
        "operationId": "listApprovals",
        "security": [
          {
            "ViewerBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pending approvals; same presentation in state and SSE",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approvals": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Approval"
                      }
                    }
                  },
                  "required": [
                    "approvals"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OwnerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Must resolve to owner using existing _require_owner; not any valid token."
      },
      "ViewerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing read authentication; query-token SSE unchanged."
      }
    },
    "schemas": {
      "Approval": {
        "type": "object",
        "required": [
          "request_id",
          "status",
          "summary",
          "first_seen_at"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?!\\s*$)(?!.*[\\r\\n\\x00-\\x1f`|])(?!.*(?:&&|<<|\\$\\(|\\$\\{)).+$"
          },
          "what_it_does": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "affects": {
            "type": "string",
            "pattern": "^(repo|money|none|service:[^\\r\\n]+|files:[^\\r\\n]+)$"
          },
          "reversible": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "read",
              "read-only-test",
              "repo-write",
              "file-write",
              "delete",
              "process-control",
              "service-control",
              "permissions",
              "network-write",
              "dns-change",
              "spend",
              "unknown"
            ]
          },
          "needs_care": {
            "type": "boolean"
          },
          "contract_version": {
            "const": "1.0.0"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "denied"
            ]
          },
          "first_seen_at": {
            "type": [
              "number",
              "null"
            ]
          },
          "requested_at": {
            "type": "number"
          }
        }
      },
      "Presentation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:onendo:approval-presentation:1.0.0",
        "title": "Normalized approval presentation",
        "type": "object",
        "required": [
          "summary",
          "what_it_does",
          "affects",
          "reversible",
          "detail",
          "classification",
          "needs_care",
          "contract_version"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?!\\s*$)(?!.*[\\r\\n\\x00-\\x1f`|])(?!.*(?:&&|<<|\\$\\(|\\$\\{)).+$"
          },
          "what_it_does": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "affects": {
            "type": "string",
            "pattern": "^(repo|money|none|service:[^\\r\\n]+|files:[^\\r\\n]+)$"
          },
          "reversible": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "read",
              "read-only-test",
              "repo-write",
              "file-write",
              "delete",
              "process-control",
              "service-control",
              "permissions",
              "network-write",
              "dns-change",
              "spend",
              "unknown"
            ]
          },
          "needs_care": {
            "type": "boolean"
          },
          "contract_version": {
            "const": "1.0.0"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "unknown"
                }
              },
              "required": [
                "classification"
              ]
            },
            "then": {
              "properties": {
                "summary": {
                  "const": "Unclassified action — inspect the detail"
                },
                "needs_care": {
                  "const": true
                },
                "reversible": {
                  "const": false
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  }
}
